# API the portal talks to (SBQR.Api from rvl-secure-bqr-manager, `dotnet run`
# defaults to http://localhost:5001). The browser only ever calls its own origin;
# /v1 and /openapi are forwarded here:
#   - dev/preview: by the Vite proxy (vite.config.ts), read from this file;
#   - Vercel: by routes that scripts/vercel-output.mjs generates at build time.
#     Set SBQR_API_URL in the Vercel dashboard per environment, e.g.
#     https://rvl-sbqr-api-dev.fly.dev (https origin only; the build fails if unset).
SBQR_API_URL=http://localhost:5001

# Dev server port (5173 = app-emulator, 5174 = admin-portal in the workspace).
PORT=5175

