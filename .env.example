# Target for the Vite dev/preview proxy (SBQR.Api from rvl-secure-bqr-manager,
# `dotnet run` defaults to http://localhost:5001). Production uses the
# vercel.json rewrites instead.
SBQR_API_URL=http://localhost:5001

# Dev server port (5173 = app-emulator, 5174 = admin-portal in the workspace).
PORT=5175

# Demo sign-in (accounts in src/shared/auth/mock.ts) for the prototype phase.
# Set to false to sign in with real API client credentials (client_id +
# client_secret exchanged at POST /v1/oauth/token). Leave off in production.
VITE_MOCK_AUTH=true
